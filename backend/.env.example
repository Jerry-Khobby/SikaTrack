# Copy to .env (never commit .env). Host values below are for running the API on Windows;
# docker-compose overrides the hosts inside Docker.

ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000

# --- Postgres: the backend's own login (created by the api-db-init service) ---
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_NAME=sikatrack_dw
DATABASE_USER=sikatrack_api
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DATABASE_PASSWORD=

# --- Object store: the RustFS data lake (same keys as data-engineering/.env for now) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
RAW_BUCKET=sikatrack-raw

# --- Docker network of the data stack (only change if you renamed its folder) ---
DATA_STACK_NETWORK=data-engineering_sikatrack

# --- Tests only: an account that may create databases, for the integration tests ---
# TEST_DATABASE_URL=postgresql+asyncpg://sika:<warehouse password>@localhost:5434/postgres
