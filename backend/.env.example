# Copy to .env (never commit .env). Host values below are for running the API on Windows;
# docker-compose overrides the hosts inside Docker.

ENVIRONMENT=development
LOG_LEVEL=INFO
API_PORT=8000

# --- Postgres: the backend's own login (created by the api-db-init service) ---
DATABASE_HOST=localhost
DATABASE_PORT=5434
DATABASE_NAME=sikatrack_dw
DATABASE_USER=sikatrack_api
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
DATABASE_PASSWORD=

# --- Object store: the RustFS data lake (same keys as data-engineering/.env for now) ---
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
RAW_BUCKET=sikatrack-raw

# --- Auth ---
# Each at least 32 characters. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
OTP_PEPPER=
# console = print sign-in codes to the API's output (development only; refused in production)
OTP_PROVIDER=console
MIN_APP_VERSION=1.0.0

# --- Pipeline ---
# Shared with data-engineering/.env: the pipeline uses it to report finished runs
INTERNAL_API_TOKEN=
# Airflow's REST API, to start a user's pipeline run after they upload (the admin login from
# data-engineering/.env). Leave AIRFLOW_PASSWORD empty to disable triggering.
AIRFLOW_URL=http://localhost:8080
AIRFLOW_USERNAME=admin
AIRFLOW_PASSWORD=

# --- Push notifications ---
# expo = push through Expo's service (set once the app exists); disabled = in-app inbox only
PUSH_PROVIDER=disabled
EXPO_ACCESS_TOKEN=

# --- HTTPS proxy (Caddy) ---
# localhost = a local certificate (development); a real domain = Let's Encrypt (production)
API_DOMAIN=localhost
PROXY_HTTP_PORT=80
PROXY_HTTPS_PORT=443

# --- SMS for sign-in codes ---
# OTP_PROVIDER: arkesel or twilio send real SMS (production); console prints codes (development only)
# Arkesel (Ghanaian gateway, topped up with mobile money): API key and registered sender ID (max 11 chars)
ARKESEL_API_KEY=
ARKESEL_SENDER=SikaTrack
# Twilio: the account, and an approved alphanumeric sender ID or number, or a messaging service
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# An approved alphanumeric sender ID (e.g. SikaTrack) or a Twilio number, or a messaging service
TWILIO_FROM=
TWILIO_MESSAGING_SERVICE_SID=

# --- Rate limits per minute (sign-in and uploads have tighter ones of their own) ---
RATE_LIMIT_PER_USER=120
RATE_LIMIT_PER_IP=30

# --- Docker network of the data stack (only change if you renamed its folder) ---
DATA_STACK_NETWORK=data-engineering_sikatrack

# --- Tests only: an account that may create databases, for the integration tests ---
# TEST_DATABASE_URL=postgresql+asyncpg://sika:<warehouse password>@localhost:5434/postgres
