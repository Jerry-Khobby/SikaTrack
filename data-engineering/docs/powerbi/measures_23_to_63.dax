        VAR FirstKey = CALCULATE ( MIN ( Transactions[date_key] ), REMOVEFILTERS () )
        VAR LastKey  = CALCULATE ( MAX ( Transactions[date_key] ), REMOVEFILTERS () )
        RETURN
            COUNTROWS (
                FILTER (
                    VALUES ( 'Date'[date_key] ),
                    'Date'[date_key] >= FirstKey && 'Date'[date_key] <= LastKey
