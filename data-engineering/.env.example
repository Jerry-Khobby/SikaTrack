# Copy to .env (never commit .env).
# The same file serves local development (no Docker) and docker-compose:
# values below are the LOCAL ones; docker-compose overrides the hosts/ports
# the pipeline uses so it reaches the other containers.

# --- MinIO (data lake) ---
MINIO_ROOT_USER=sikatrack
MINIO_ROOT_PASSWORD=change-me-minio-123
MINIO_ENDPOINT=http://localhost:9000
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# raw:       sms_backup/ingest_date=YYYY-MM-DD/<file>.xml   (immutable, versioned)
# processed: transactions/ingest_date=YYYY-MM-DD/transactions.parquet
RAW_BUCKET=sikatrack-raw
PROCESSED_BUCKET=sikatrack-processed

# --- Postgres warehouse (Power BI connects here) ---
WAREHOUSE_HOST=localhost
# Local Postgres; inside Docker the pipeline uses warehouse:5432 instead
WAREHOUSE_PORT=5432
WAREHOUSE_DB=sikatrack_dw
WAREHOUSE_USER=sika
WAREHOUSE_PASSWORD=change-me-dw-123
# Docker only: host port mapped to the warehouse container (what Power BI uses then)
WAREHOUSE_HOST_PORT=5434

# --- Airflow (Docker only) ---
AIRFLOW_VERSION=3.0.6
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-airflow-123
AIRFLOW_DB_PASSWORD=change-me-airflow-db-123
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# --- Transform: your own accounts (comma-separated) ---
# Transfers to/from these are flagged is_internal_transfer, so they don't count as income/spending.
# Names as they appear in SMS (any case); numbers in local format, e.g. 0241234567
OWNER_NAMES=
OWNER_NUMBERS=
