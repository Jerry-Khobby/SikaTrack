# Copy to .env (never commit .env).
# Hosts and ports below reach the Docker services from Windows (e.g. Power BI, a manual run);
# docker-compose overrides them inside the containers so services reach each other.

# --- S3-compatible object storage (RustFS in Docker) ---
S3_ACCESS_KEY=sikatrack
S3_SECRET_KEY=change-me-s3-secret-123
S3_ENDPOINT=http://localhost:9000
S3_API_PORT=9000
S3_CONSOLE_PORT=9001

# --- Data lake buckets ---
# raw:       sms_backup/ingest_date=YYYY-MM-DD/<file>-<hash>.xml   (never overwritten)
# processed: transactions/transactions.parquet + reports/run_id=<id>/quality_report.json
RAW_BUCKET=sikatrack-raw
PROCESSED_BUCKET=sikatrack-processed

# --- Postgres warehouse (Power BI connects here) ---
WAREHOUSE_HOST=localhost
# From Windows: the Postgres container's host port. Inside Docker the pipeline uses warehouse:5432
WAREHOUSE_PORT=5434
WAREHOUSE_DB=sikatrack_dw
WAREHOUSE_USER=sika
WAREHOUSE_PASSWORD=change-me-dw-123
# Host port published by the warehouse container; keep equal to WAREHOUSE_PORT
WAREHOUSE_HOST_PORT=5434

# --- Airflow ---
AIRFLOW_VERSION=3.0.6
AIRFLOW_UID=50000
AIRFLOW_PORT=8080
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=change-me-airflow-123
AIRFLOW_DB_PASSWORD=change-me-airflow-db-123
# Generate each with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_JWT_SECRET=
AIRFLOW_API_SECRET_KEY=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=

# --- Transform: your own accounts (comma-separated) ---
# Transfers to/from these are flagged is_internal_transfer, so they don't count as income/spending.
# Names as they appear in SMS (any case); numbers in local format, e.g. 0241234567
OWNER_NAMES=
OWNER_NUMBERS=

# --- Logging: DEBUG also logs every ignored/duplicate SMS ---
LOG_LEVEL=INFO

# --- Quality gates: the pipeline fails when a metric crosses its limit ---
GATE_MIN_PARSE_RATE=0.95
GATE_MIN_BALANCE_CONTINUITY=0.98
GATE_MAX_UNEXPLAINED_GAPS=20
GATE_MIN_CATEGORY_COVERAGE=0.90

# --- Alerts (email) ---
# Gmail: EMAIL_USER is the address, EMAIL_PASS a 16-letter app password
# (Google Account > Security > 2-Step Verification > App passwords). Never your normal password.
EMAIL_USER=
EMAIL_PASS=
# Who receives alerts, comma-separated (default: EMAIL_USER)
ALERT_EMAIL_TO=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# false = no emails at all (logged instead); DIGEST_ENABLED=false = emails only when something is wrong
ALERTS_ENABLED=true
DIGEST_ENABLED=true
# Windows watchdog (scripts/watchdog.cmd); set false while the stack is intentionally down
WATCHDOG_ENABLED=true
# Base URL for links in alert emails
AIRFLOW_PUBLIC_URL=http://localhost:8080

# --- Monitoring limits (daily check) ---
MONITOR_MAX_HOURS_SINCE_PIPELINE=36
MONITOR_MAX_DAYS_SINCE_BACKUP=14
MONITOR_MAX_DAYS_BACKUP_NOT_LOADED=2
# Early warnings: tighter than the GATE_* limits, so you hear about drift before a run fails
MONITOR_WARN_MIN_PARSE_RATE=0.98
MONITOR_WARN_MIN_CATEGORY_COVERAGE=0.95
MONITOR_WARN_MIN_BALANCE_CONTINUITY=0.99
MONITOR_WARN_MAX_UNEXPLAINED_GAPS=10
MONITOR_WARN_MAX_COVERAGE_DROP=0.02
